node_modules/
.env
.env.*
!.env.example
server/generated/
*.log
.DS_Store

# Runtime uploads (product images/resources/media) — persisted on the
# server's disk, not version-controlled; mixes real product deliverables
# with orphaned/test uploads that shouldn't ride along in source history.
server/storage/
# Same reasoning for the two public upload directories: gallery slides and
# cover uploads are written by the admin panel at runtime (and by the builder's
# media library), and only the checked-in demo/ art belongs in git.
assets/images/product/gallery/
assets/images/product/uploads/
server/_proxy.js
server/_apitest.js

# Generated media artifacts (tools/backfill-media-derivatives.js, and the
# upload pipeline in server/src/lib/mediaDerivatives.js). Deterministic output
# derived from the source image next to them, regenerated by the backfill on
# deploy. Committing them would put hundreds of binaries in the repo for no
# benefit — and a missing manifest degrades safely: coverMedia() returns null
# and the storefront falls back to the plain imageUrl it used before.
*.media.json
*-320.avif
*-320.webp
*-640.avif
*-640.webp
*-960.avif
*-960.webp
*-1280.avif
*-1280.webp
