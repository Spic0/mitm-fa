node_modules/
.env
.env.*
!.env.example
server/generated/
*.log
.DS_Store

# Runtime uploads (product images/resources/media) — persisted on the
# server's disk, not version-controlled; mixes real product deliverables
# with orphaned/test uploads that shouldn't ride along in source history.
server/storage/
# Same reasoning for the two public upload directories: gallery slides and
# cover uploads are written by the admin panel at runtime (and by the builder's
# media library), and only the checked-in demo/ art belongs in git.
assets/images/product/gallery/
assets/images/product/uploads/
server/_proxy.js
server/_apitest.js
