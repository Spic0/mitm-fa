# development | production — never set to anything but "production" on the live server
NODE_ENV="development"

# Second, independent gate on top of NODE_ENV for /api/dev/* (instant admin
# login, simulated purchases, etc). Must be explicitly "true" to enable dev
# tools even in a non-production NODE_ENV — leave unset/absent everywhere
# except local dev. Never set this in any deployed environment.
ENABLE_DEV_ROUTES="true"

# Postgres connection string (see docker-compose.yml for a local instance)
DATABASE_URL="postgresql://profit:profit@localhost:5432/profit?schema=public"

# Base URL the server is reachable at (used to build magic-link and webhook URLs)
APP_URL="http://localhost:3000"

# Comma-separated emails granted the admin role by prisma/seed.js
ADMIN_EMAILS="admin1@example.com,admin2@example.com"

# Random long string used to sign session cookies
SESSION_SECRET="replace-with-a-long-random-string"

# Random long string used to derive per-session CSRF tokens (server/src/lib/csrf.js).
# Generate with: openssl rand -hex 32
CSRF_SECRET="replace-with-a-long-random-string"

# Stripe test-mode keys (https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY="sk_test_xxx"
STRIPE_PUBLISHABLE_KEY="pk_test_xxx"
STRIPE_WEBHOOK_SECRET="whsec_xxx"

# PayPal sandbox app credentials (https://developer.paypal.com/dashboard/applications/sandbox)
PAYPAL_CLIENT_ID="sandbox_client_id"
PAYPAL_CLIENT_SECRET="sandbox_client_secret"
PAYPAL_API_BASE="https://api-m.sandbox.paypal.com"

# Resend API key (https://resend.com/api-keys)
RESEND_API_KEY="re_xxx"
RESEND_FROM_EMAIL="ProFit <onboarding@resend.dev>"
