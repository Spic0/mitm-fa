node_modules/
.env
.env.*
!.env.example
server/generated/
*.log
.DS_Store

# Runtime uploads (product images/resources/media) — persisted on the
# server's disk, not version-controlled; mixes real product deliverables
# with orphaned/test uploads that shouldn't ride along in source history.
server/storage/
# Same reasoning for the two public upload directories: gallery slides and
# cover uploads are written by the admin panel at runtime (and by the builder's
# media library), and only the checked-in demo/ art belongs in git.
assets/images/product/gallery/
assets/images/product/uploads/
server/_proxy.js
server/_apitest.js

# Generated media artifacts (tools/backfill-media-derivatives.js, and the
# upload pipeline in server/src/lib/mediaDerivatives.js). Deterministic output
# derived from the source image next to them, regenerated by the backfill on
# deploy. Committing them would put hundreds of binaries in the repo for no
# benefit — and a missing manifest degrades safely: coverMedia() returns null
# and the storefront falls back to the plain imageUrl it used before.
*.media.json
*-320.avif
*-320.webp
*-640.avif
*-640.webp
*-960.avif
*-960.webp
*-1280.avif
*-1280.webp
# Email renditions of product covers (server/src/lib/emailImage.js): the same
# kind of derived artifact, built on first use because a cover can be uploaded
# at any time. A missing one degrades to a receipt with no thumbnail, never to
# a broken image.
*-email.jpg

# Landing-page marketing imagery (assets/images/landing/). Operator-supplied
# and dropped straight onto the production box — see
# server/docs/landing-assets.md. Deliberately NOT tracked, for the same reason
# product uploads aren't, plus one specific to this deploy: production is
# updated with `git merge --ff-only`, and an untracked file on the box blocks
# any merge that would introduce a tracked file of the same name. Keeping these
# out of git means dropping an image can never wedge a deploy.
#
# CONSEQUENCE: these files exist ONLY on the box and are not in git history.
# They must be part of the server backup, not relied on to survive a re-clone.
assets/images/landing/*
!assets/images/landing/.gitkeep
!assets/images/landing/README.md

# Screenshots from tools/test-landing-responsive.js --shots.
tools/.shots/

# TLS material. Nothing here has ever been committed and nothing should be:
# the production certificate and private key live at
# /etc/ssl/fitness.agency/ (key 0600 root:root), outside the repo entirely.
# These patterns exist so an accidental `cp` into the checkout cannot be
# staged. The certificate itself is public, but it is versioned by the CA and
# not by us, so it is excluded alongside the key.
*.key
*.pem
*.cer
*.crt
*.p12
*.pfx
SSL/
ssl/
