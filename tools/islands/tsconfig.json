{
  "compilerOptions": {
    "target": "ES2020", "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx",
    "lib": ["ES2020", "DOM", "DOM.Iterable"], "strict": true, "skipLibCheck": true, "noEmit": true,
    "isolatedModules": true, "esModuleInterop": true, "types": ["vite/client"],
    "baseUrl": ".", "paths": { "@/*": ["src/*"] }
  },
  "include": ["src"]
}
