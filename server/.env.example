# development | production — never set to anything but "production" on the live server
NODE_ENV="development"

# Second, independent gate on top of NODE_ENV for /api/dev/* (instant admin
# login, simulated purchases, etc). Must be explicitly "true" to enable dev
# tools even in a non-production NODE_ENV — leave unset/absent everywhere
# except local dev. Never set this in any deployed environment.
ENABLE_DEV_ROUTES="true"

# Postgres connection string (see docker-compose.yml for a local instance)
DATABASE_URL="postgresql://profit:profit@localhost:5432/profit?schema=public"

# Base URL the server is reachable at (used to build magic-link and webhook URLs)
APP_URL="http://localhost:3000"

# Comma-separated emails granted the admin role by prisma/seed.js
ADMIN_EMAILS="admin1@example.com,admin2@example.com"

# Random long string used to sign session cookies
SESSION_SECRET="replace-with-a-long-random-string"

# Random long string used to derive per-session CSRF tokens (server/src/lib/csrf.js).
# Generate with: openssl rand -hex 32
CSRF_SECRET="replace-with-a-long-random-string"

# Stripe test-mode keys (https://dashboard.stripe.com/test/apikeys).
# All three are required for card payment to work at all. With any of them
# missing the card tab is marked "Unavailable" in the checkout UI and the
# checkout API answers 503 — deliberately, so an unconfigured store shows a
# shopper an explanation rather than a raw Stripe authentication error at the
# moment they try to pay. index.js logs which ones are missing at boot.
#
# STRIPE_SECRET_KEY and STRIPE_WEBHOOK_SECRET are SERVER-ONLY and must never
# reach the browser. STRIPE_PUBLISHABLE_KEY is the only one served to the
# client (via GET /api/config) and is safe there by design.
#
# The webhook secret comes from the endpoint you create at
# https://dashboard.stripe.com/webhooks pointing at
#   <APP_URL>/api/webhooks/stripe
# subscribed to: payment_intent.succeeded, payment_intent.payment_failed,
#                charge.refunded
STRIPE_SECRET_KEY="sk_test_xxx"
STRIPE_PUBLISHABLE_KEY="pk_test_xxx"
STRIPE_WEBHOOK_SECRET="whsec_xxx"

# PayPal sandbox app credentials (https://developer.paypal.com/dashboard/applications/sandbox)
# Leaving CLIENT_ID/CLIENT_SECRET unset is a supported state: the PayPal tab
# is marked "Unavailable" in the checkout UI and the API answers 503 rather
# than failing at PayPal's auth endpoint mid-payment.
PAYPAL_CLIENT_ID="sandbox_client_id"
PAYPAL_CLIENT_SECRET="sandbox_client_secret"
# Sandbox: https://api-m.sandbox.paypal.com
# LIVE:    https://api-m.paypal.com
# This is the ONLY thing that decides whether PayPal takes real money — the
# credentials look identical either way. index.js warns at boot if this
# disagrees with whether STRIPE_SECRET_KEY is a live key.
PAYPAL_API_BASE="https://api-m.sandbox.paypal.com"

# The webhook's id from https://developer.paypal.com/dashboard/webhooks —
# NOT a secret, but required: PayPal signature verification is a call back to
# PayPal that includes this id, and without it every delivery fails closed.
# A PayPal payment whose buyer closes the browser before the capture call
# returns is then never fulfilled, which is the exact case the webhook exists
# to cover. Point the webhook at:  <APP_URL>/api/webhooks/paypal
# subscribed to: PAYMENT.CAPTURE.COMPLETED, PAYMENT.CAPTURE.DENIED,
#                PAYMENT.CAPTURE.REFUNDED, PAYMENT.CAPTURE.REVERSED
PAYPAL_WEBHOOK_ID="WH-XXXXXXXXXXXXXXXXX-XXXXXXXXXXXXXXXX"

# Resend API key (https://resend.com/api-keys).
# A real key is "re_" plus ~33 characters. Anything much shorter is still the
# placeholder — and a placeholder here does NOT fail loudly: Resend's SDK
# resolves with an { error } object rather than throwing, so sign-in links and
# purchase receipts fail silently while the app carries on. Verify with:
#   node scripts/check-email.js
RESEND_API_KEY="re_xxx"

# MUST be an address on a domain verified at https://resend.com/domains.
# onboarding@resend.dev is Resend's shared sandbox sender: it only delivers to
# the address that owns the Resend account, so every customer sign-in link and
# receipt sent from it is rejected. Leaving this unset falls back to exactly
# that sandbox sender (see src/lib/email.js getFrom).
RESEND_FROM_EMAIL="Fitness Agency <noreply@fitness.agency>"

# Address printed in the footer of every customer-facing email, and the
# fallback Reply-To for contact acknowledgements. Falls back to CONTACT_INBOX
# and then to office@fitness.agency, so templates never render a blank
# support address — but set it explicitly to whichever inbox is monitored.
SUPPORT_EMAIL="office@fitness.agency"

# Where the contact/partnership wizard delivers enquiries.
CONTACT_INBOX="office@fitness.agency"
